{
  "name": "websecrobot",
  "version": "0.1.0",
  "description": "Canlı HTTP kanıtlarına dayalı, pasif ve açık kaynak web güvenliği denetleyicisi.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "exports": {
    ".": "./src/audit.js",
    "./report": "./src/report.js",
    "./master-prompt": "./src/master-prompt.js"
  },
  "files": ["src", "docs", "prompts", "LICENSE", "README.md", "SECURITY.md"],
  "engines": { "node": ">=20.11" },
  "bin": { "websecrobot": "./bin/websecrobot.js" },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "audit": "node bin/websecrobot.js",
    "test": "node --test",
    "check": "node --check server/index.js && node --check src/audit.js && node --check public/app.js && npm test"
  },
  "keywords": ["security", "web-security", "security-headers", "csp", "hsts", "cookies"],
  "repository": { "type": "git", "url": "git+https://github.com/tialkan/webSECrobot.git" },
  "homepage": "https://tezatlas.com/websecrobot",
  "bugs": { "url": "https://github.com/tialkan/webSECrobot/issues" }
}
